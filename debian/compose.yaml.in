# epistle-panel stack fragment, installed by the epistle-panel package.
#
# It is not a stack on its own: epistle adds it to the stack it generates, so
# the service joins that stack's default network and reaches the epistle API by
# service name. The API port is never published. Do not edit this file, the
# package replaces it on upgrade; put changes in compose.override.yaml.
#
# The image tag is the package version, so `apt upgrade` is what moves the
# panel to a new release.

services:
  epistle-panel:
    image: ghcr.io/glyndor/epistle-panel:@VERSION@
    user: "65532:65532"
    # Loopback only. TLS and public exposure belong to the operator's proxy.
    ports:
      - "127.0.0.1:7587:7587"
    environment:
      EPISTLE_API_URL: http://mail:8025
      EPISTLE_API_TOKEN_FILE: /run/secrets/epistle_api_token
      EPISTLE_PANEL_SESSION_SECRET_FILE: /run/secrets/epistle_panel_session_secret
    secrets:
      - source: epistle_api_token
        target: epistle_api_token
        uid: "65532"
        gid: "65532"
        mode: 400
      - source: epistle_panel_session_secret
        target: epistle_panel_session_secret
        uid: "65532"
        gid: "65532"
        mode: 400
    restart: unless-stopped
    security_opt:
      - no-new-privileges
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp:size=64m,mode=1777
    # The image is distroless: no shell and no curl, so the probe is Node itself.
    healthcheck:
      test:
        - CMD
        - /nodejs/bin/node
        - -e
        - "fetch('http://127.0.0.1:7587/login').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s

secrets:
  epistle_api_token:
    file: /etc/glyndor/epistle-panel/secrets/epistle_api_token
  epistle_panel_session_secret:
    file: /etc/glyndor/epistle-panel/secrets/epistle_panel_session_secret
